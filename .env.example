# ── OpenCockpeet — configuration locale ─────────────────────────────────
# Copie ce fichier en .env puis ajuste. Aucun secret n'est commité.

# dev : config.settings.dev · live/prod locale : config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Obligatoire en prod (générer : python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=

# Hôtes autorisés (ajouter l'IP LAN pour la vue télé, ex: 192.168.1.20)
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis : channel layer (prod) + broker Celery
REDIS_URL=redis://127.0.0.1:6379/0

# Runtime des panes
COCKPIT_DEFAULT_CMD=claude
COCKPIT_ALLOWED_CMDS=claude,bash,sh
COCKPIT_MAX_PANES=12
COCKPIT_BUFFER_BYTES=200000

TIME_ZONE=Europe/Paris

# Prod derrière un reverse proxy TLS local ; mettre à False si accès direct LAN http
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0

# ── Chat headless (Sprint 4) ──
COCKPIT_CLAUDE_BIN=claude
# Args du mode chat. Ajouter --dangerously-skip-permissions pour l'autonomie
# des outils (choix explicite, voir SECURITY.md).
# COCKPIT_CLAUDE_HEADLESS_ARGS=-p,--output-format,stream-json,--input-format,stream-json,--verbose

# ── Exploitation (Sprint 5) ──
COCKPIT_HEARTBEAT_STALE_SECONDS=90
COCKPIT_EVENTLOG_RETENTION_DAYS=30
# Répertoire d'archive des events purgés (vide = purge sèche)
COCKPIT_EVENTLOG_ARCHIVE_DIR=
# Commande optionnelle renvoyant l'usage réel de l'abonnement en JSON
# COCKPIT_USAGE_CMD=claude,usage,--json

# ── Voix & accès (Sprint 6) ──
# Jeton partagé pour protéger l'accès LAN (vide = désactivé, dev localhost)
COCKPIT_LAN_TOKEN=
# Reprendre les sessions interrompues par un redémarrage (bouton + reprise auto)
COCKPIT_RESUME_ON_BOOT=False

# ── Reconnaissance vocale serveur (Sprint 7) ──
# webspeech (défaut, navigateur) | crisperwhisper (serveur, verbatim) | fake (test)
COCKPIT_STT_BACKEND=webspeech
# Modèle CTranslate2 pour faster-whisper (ou chemin local)
COCKPIT_STT_MODEL=nyralabs/faster_CrisperWhisper
COCKPIT_STT_DEVICE=auto
COCKPIT_STT_COMPUTE_TYPE=int8
COCKPIT_STT_LANGUAGE=fr
